{
  "description": "Host-owned codescratch graph freshness (ensure single-flight)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-hook.cjs\" --notify",
            "statusMessage": "codescratch ensure"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-hook.cjs\"",
            "statusMessage": "codescratch ensure (edit)"
          }
        ]
      }
    ]
  }
}
